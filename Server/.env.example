# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/click_tracker

# IP Geolocation API (Free tier - https://ipgeolocation.io/)
IPGEOLOCATION_API_KEY=your_ipgeolocation_api_key_here

# Base URL for tracking links (used to generate tracking URLs)
BASE_URL=http://localhost:3000

# Optional: Admin credentials for dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure_password_here